[user]
	name = moeezali2375
	email = moeezali2375@gmail.com
	signingkey = ~/.ssh/github-personal-moeez-ali-v5-signing.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[alias]
	l = log --oneline
	s = status
[core]
	excludesfile = ~/.gitignore_global
	ignorecase = true
[push]
	autoSetupRemote = true
[diff]
	tool = nvimdiff
[difftool]
	prompt = false

[includeIf "gitdir:~/Developer/dubizzle/"]
	path = ~/.gitconfig_dubizzle

